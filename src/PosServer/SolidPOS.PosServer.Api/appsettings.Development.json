{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=solidpos;Username=solidpos;Password=solidpos_dev_password"
  },
  "Jwt": {
    "SigningKey": "dev-only-solidpos-signing-key-change-before-production"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000",
      "http://localhost:5000"
    ]
  },
  "RateLimits": {
    "PermitLimit": 600,
    "WindowMinutes": 1,
    "QueueLimit": 0
  },
  "PasswordPolicy": {
    "MinLength": 12,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireNonAlphanumeric": true,
    "BlockCommonPasswords": true
  },
  "AccountSecurity": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15
  }
}
