{
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "SolidPOS",
    "Audience": "SolidPOS.Clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "TerminalAccessTokenDays": 7
  },
  "PasswordHashing": {
    "WorkFactor": 12
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "localhost",
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimits": {
    "PermitLimit": 600,
    "WindowMinutes": 1,
    "QueueLimit": 0
  },
  "PasswordPolicy": {
    "MinLength": 12,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireNonAlphanumeric": true,
    "BlockCommonPasswords": true
  },
  "AccountSecurity": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15
  },
  "Observability": {
    "ServiceName": "SolidPOS.PosServer",
    "ConsoleExporterEnabled": true,
    "TenantIdentifiersInTelemetry": false,
    "Alerts": {
      "MinimumRequestsForErrorRateAlert": 20,
      "HttpErrorRatio": 0.05,
      "HttpP95LatencyMs": 1200,
      "ActiveNonClientWaitEventCount": 0,
      "SyncNonConvergedCount": 0,
      "DeadLetterCount": 1,
      "NegativeStockCount": 0,
      "SalePaymentMismatchCount": 0
    }
  }
}
