<Window x:Class="SolidPOS.PosBuilder.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SolidPOS PosBuilder" Height="660" Width="980" MinHeight="560" MinWidth="820">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16" Background="#20242A">
      <StackPanel>
        <TextBlock Text="SolidPOS PosBuilder" FontSize="24" FontWeight="Bold" Foreground="White" />
        <TextBlock Text="Tenant Branding Package Foundation" Foreground="#D7DCE2" />
      </StackPanel>
    </Border>
    <Grid Margin="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Text="{Binding Status}" FontSize="16" FontWeight="Bold" />
      <Grid Grid.Row="1" Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Tenant" FontSize="20" FontWeight="Bold" />
          <TextBlock Text="Tenant ID" Margin="0,12,0,2" />
          <TextBox Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Tenant name" Margin="0,12,0,2" />
          <TextBox Text="{Binding TenantName, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="App name" Margin="0,12,0,2" />
          <TextBox Text="{Binding AppName, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Output package" Margin="0,12,0,2" />
          <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="24,0,0,0">
          <TextBlock Text="Visual / Receipt" FontSize="20" FontWeight="Bold" />
          <TextBlock Text="Primary color" Margin="0,12,0,2" />
          <TextBox Text="{Binding PrimaryColorHex, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Accent color" Margin="0,12,0,2" />
          <TextBox Text="{Binding AccentColorHex, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Logo path" Margin="0,12,0,2" />
          <TextBox Text="{Binding LogoPath, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Receipt header" Margin="0,12,0,2" />
          <TextBox Text="{Binding ReceiptHeader, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="Receipt footer" Margin="0,12,0,2" />
          <TextBox Text="{Binding ReceiptFooter, UpdateSourceTrigger=PropertyChanged}" />
          <Button Content="Generar paquete" Command="{Binding GeneratePackageCommand}" Height="42" Margin="0,16,0,0" />
          <Button Content="Validar paquete" Command="{Binding ValidatePackageCommand}" Height="42" Margin="0,8,0,0" />
          <UniformGrid Columns="2" Rows="3" Margin="0,12,0,0">
            <TextBlock Text="Valid" FontWeight="Bold" />
            <TextBlock Text="{Binding IsValid}" />
            <TextBlock Text="Errors" FontWeight="Bold" />
            <TextBlock Text="{Binding ErrorCount}" />
            <TextBlock Text="Warnings" FontWeight="Bold" />
            <TextBlock Text="{Binding WarningCount}" />
          </UniformGrid>
        </StackPanel>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
