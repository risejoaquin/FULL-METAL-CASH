<Window x:Class="SolidPOS.PosCore.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SolidPOS PosCore" Height="760" Width="1180" MinHeight="650" MinWidth="980">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16" Background="#20242A">
      <StackPanel>
        <TextBlock Text="{Binding Branding.AppName}" FontSize="24" FontWeight="Bold" Foreground="White" />
        <TextBlock Text="{Binding Branding.TenantName}" Foreground="#D7DCE2" />
      </StackPanel>
    </Border>

    <Grid Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Padding="12" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Runtime DB:" FontWeight="Bold" />
          <TextBlock Text="{Binding DatabasePath}" Margin="4,0,0,0" />
          <TextBlock Text=" | Shell:" FontWeight="Bold" Margin="16,0,4,0" />
          <TextBlock Text="{Binding ShellStatus}" />
        </StackPanel>
      </Border>

      <TabControl Grid.Row="1" Margin="0,16,0,0">
        <TabItem Header="Branding" Visibility="{Binding SimulationTabVisibility}">
          <StackPanel Margin="20">
            <TextBlock Text="Tenant branding" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="{Binding Branding.Status}" Margin="0,12,0,0" />
            <TextBlock Text="{Binding Branding.HeaderSummary}" FontWeight="Bold" Margin="0,8,0,0" />
            <TextBlock Text="{Binding Branding.ReceiptSummary}" />
            <UniformGrid Columns="2" Rows="4" Width="520" HorizontalAlignment="Left" Margin="0,12,0,0">
              <TextBlock Text="Primary" FontWeight="Bold" />
              <TextBlock Text="{Binding Branding.PrimaryColorHex}" />
              <TextBlock Text="Accent" FontWeight="Bold" />
              <TextBlock Text="{Binding Branding.AccentColorHex}" />
              <TextBlock Text="Logo" FontWeight="Bold" />
              <TextBlock Text="{Binding Branding.LogoPath}" />
              <TextBlock Text="Receipt header" FontWeight="Bold" />
              <TextBlock Text="{Binding Branding.ReceiptHeader}" />
            </UniformGrid>
          </StackPanel>
        </TabItem>

        <TabItem Header="Login" Visibility="{Binding SimulationTabVisibility}">
          <StackPanel Margin="20">
            <TextBlock Text="Login local offline" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="Email" FontWeight="Bold" Margin="0,12,0,2" />
            <TextBox Text="{Binding Login.Email, UpdateSourceTrigger=PropertyChanged}" Width="340" HorizontalAlignment="Left" />
            <TextBlock Text="Estado" FontWeight="Bold" Margin="0,12,0,2" />
            <TextBlock Text="{Binding Login.Status}" />
            <Button Content="Validar shell de login" Command="{Binding Login.ValidateCommand}" Width="180" HorizontalAlignment="Left" Margin="0,12,0,0" />
          </StackPanel>
        </TabItem>

        <TabItem Header="Activación / Estado real" Visibility="{Binding ProductionTabVisibility}">
          <StackPanel Margin="24">
            <TextBlock Text="SolidPOS — punto de venta aún no habilitado" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ShellStatus}" TextWrapping="Wrap" Margin="0,18,0,10" FontSize="15"/>
            <TextBlock Text="{Binding TerminalStatus.Status}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding TerminalStatus.BindingSummary}" TextWrapping="Wrap" Margin="0,8,0,10" />
            <GroupBox Header="Catálogo y carrito local — sin cobro" Margin="0,8,0,8" MaxWidth="660" HorizontalAlignment="Left">
              <StackPanel Margin="12" DataContext="{Binding ProductionCart}">
                <TextBlock Text="Buscar SKU activo en SQLite" />
                <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                <StackPanel Orientation="Horizontal">
                  <Button Content="Agregar SKU" Click="ProductionAddSku_Click" Padding="12,6" />
                  <Button Content="Vaciar carrito" Click="ProductionClearCart_Click" Padding="12,6" Margin="8,0,0,0" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True" Height="150" Margin="0,10,0,0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="*" />
                    <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Cant." Binding="{Binding Quantity}" />
                    <DataGridTextColumn Header="Precio centavos" Binding="{Binding UnitPriceCents}" />
                    <DataGridTextColumn Header="Subtotal centavos" Binding="{Binding SubtotalCents}" />
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding TotalCents, StringFormat={}{0} centavos}" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
              </StackPanel>
            </GroupBox>
            <TextBlock Text="{Binding Sales.CatalogSummary}" TextWrapping="Wrap" />
            <GroupBox Header="Acceso del operador (SQLite local)" Margin="0,12,0,12" MaxWidth="560" HorizontalAlignment="Left">
              <StackPanel Margin="12" DataContext="{Binding ProductionLogin}">
                <TextBlock Text="Correo electrónico" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                <TextBlock Text="Contraseña" />
                <PasswordBox x:Name="ProductionPassword" Margin="0,4,0,10" />
                <StackPanel Orientation="Horizontal">
                  <Button Content="Iniciar sesión" IsEnabled="{Binding CanLogin}" Click="ProductionLogin_Click" Padding="16,8" />
                  <Button Content="Cerrar sesión" IsEnabled="{Binding CanLogout}" Click="ProductionLogout_Click" Margin="8,0,0,0" Padding="16,8" />
                </StackPanel>
                <TextBlock Text="{Binding Operator}" FontWeight="Bold" Margin="0,12,0,4" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
              </StackPanel>
            </GroupBox>
            <TextBlock Text="Esta interfaz no registra cobros ni abre caja ni confirma sincronización. El acceso autenticado no habilita ventas." TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock Text="La activación, el login y el cobro transaccional se habilitarán después de superar sus pruebas de integración. Esta pantalla no es una demostración de ventas." TextWrapping="Wrap" Margin="0,12,0,0" />
          </StackPanel>
        </TabItem>

        <TabItem Header="Terminal">
          <StackPanel Margin="20">
            <TextBlock Text="Estado de terminal" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="{Binding TerminalStatus.Status}" Margin="0,12,0,0" />
            <TextBlock Text="{Binding TerminalStatus.BindingSummary}" />
          </StackPanel>
        </TabItem>

        <TabItem Header="Venta QSR" Visibility="{Binding SimulationTabVisibility}">
          <Grid Margin="20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Text="Catalogo local" FontSize="20" FontWeight="Bold" />
              <TextBlock Text="{Binding Sales.CatalogSummary}" TextWrapping="Wrap" Margin="0,8,0,12" />
              <Button Content="Americano 12oz" Command="{Binding Sales.AddAmericanoCommand}" Height="64" FontSize="18" />
              <Button Content="+ Cantidad" Command="{Binding Sales.IncreaseQuantityCommand}" Height="44" Margin="0,8,0,0" />
              <Button Content="Limpiar carrito" Command="{Binding Sales.ClearCartCommand}" Height="44" Margin="0,8,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="24,0,0,0">
              <TextBlock Text="Carrito" FontSize="20" FontWeight="Bold" />
              <TextBlock Text="{Binding Sales.CartSummary}" TextWrapping="Wrap" Margin="0,8,0,12" />
              <UniformGrid Columns="2" Rows="4" Margin="0,0,0,12">
                <TextBlock Text="SKU" FontWeight="Bold" />
                <TextBlock Text="{Binding Sales.SelectedSku}" />
                <TextBlock Text="Cantidad" FontWeight="Bold" />
                <TextBlock Text="{Binding Sales.Quantity}" />
                <TextBlock Text="Total cents" FontWeight="Bold" />
                <TextBlock Text="{Binding Sales.TotalCents}" />
                <TextBlock Text="Cambio cents" FontWeight="Bold" />
                <TextBlock Text="{Binding Sales.ChangeCents}" />
              </UniformGrid>
              <TextBlock Text="Efectivo recibido cents" FontWeight="Bold" />
              <TextBox Text="{Binding Sales.TenderedCents, UpdateSourceTrigger=PropertyChanged}" Width="180" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding Sales.PaymentSummary}" TextWrapping="Wrap" Margin="0,8,0,0" />
              <Button Content="Cobrar efectivo" Command="{Binding Sales.TakeCashPaymentCommand}" Height="44" Margin="0,12,0,0" />
              <Button Content="Encolar recibo fake" Command="{Binding Sales.QueueFakeReceiptCommand}" Height="44" Margin="0,8,0,0" />
              <Button Content="Actualizar sync visual" Command="{Binding Sales.MarkSyncedCommand}" Height="44" Margin="0,8,0,0" />
              <TextBlock Text="{Binding Sales.SaleStatus}" TextWrapping="Wrap" Margin="0,12,0,0" />
              <TextBlock Text="{Binding Sales.ReceiptStatus}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Sales.PrintStatus}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Sales.SyncVisualStatus}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Sales.ConnectivityState}" FontWeight="Bold" Margin="0,12,0,0" />
              <TextBlock Text="{Binding Sales.OperatorErrorMessage}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Sales.RecoveryActionsSummary}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Retry" Command="{Binding Sales.RetryLastActionCommand}" Width="90" />
                <Button Content="Offline" Command="{Binding Sales.ContinueOfflineCommand}" Width="90" Margin="8,0,0,0" />
                <Button Content="Print" Command="{Binding Sales.RetryPrintCommand}" Width="90" Margin="8,0,0,0" />
                <Button Content="Drawer" Command="{Binding Sales.RetryDrawerCommand}" Width="90" Margin="8,0,0,0" />
                <Button Content="Reconnect" Command="{Binding Sales.ReconnectCommand}" Width="100" Margin="8,0,0,0" />
                <Button Content="Dismiss" Command="{Binding Sales.DismissErrorCommand}" Width="90" Margin="8,0,0,0" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </TabItem>

        <TabItem Header="Sync" Visibility="{Binding SimulationTabVisibility}">
          <StackPanel Margin="20">
            <TextBlock Text="Sync status" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="{Binding SyncStatus.Status}" Margin="0,12,0,0" />
            <TextBlock Text="{Binding SyncStatus.QueueSummary}" />
            <Button Content="Marcar venta pendiente" Command="{Binding SyncStatus.MarkPendingSaleCommand}" Width="190" HorizontalAlignment="Left" Margin="0,12,0,0" />
            <Button Content="Marcar venta sincronizada" Command="{Binding SyncStatus.MarkSaleSyncedCommand}" Width="210" HorizontalAlignment="Left" Margin="0,8,0,0" />
          </StackPanel>
        </TabItem>

        <TabItem Header="Caja" Visibility="{Binding SimulationTabVisibility}">
          <StackPanel Margin="20">
            <TextBlock Text="Caja local" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="{Binding CashShift.Status}" Margin="0,12,0,0" />
            <TextBlock Text="{Binding CashShift.ExpectedCashSummary}" TextWrapping="Wrap" />
            <UniformGrid Columns="2" Rows="5" Width="420" HorizontalAlignment="Left" Margin="0,12,0,12">
              <TextBlock Text="Apertura" FontWeight="Bold" />
              <TextBox Text="{Binding CashShift.OpeningAmountCents, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="Cash sales" FontWeight="Bold" />
              <TextBlock Text="{Binding CashShift.CashSalesCents}" />
              <TextBlock Text="Cash in" FontWeight="Bold" />
              <TextBlock Text="{Binding CashShift.CashInCents}" />
              <TextBlock Text="Cash out" FontWeight="Bold" />
              <TextBlock Text="{Binding CashShift.CashOutCents}" />
              <TextBlock Text="Expected" FontWeight="Bold" />
              <TextBlock Text="{Binding CashShift.ExpectedCashCents}" />
            </UniformGrid>
            <Button Content="Abrir caja local" Command="{Binding CashShift.OpenLocalShiftCommand}" Width="170" HorizontalAlignment="Left" />
            <Button Content="Cash in +1000" Command="{Binding CashShift.AddCashInCommand}" Width="170" HorizontalAlignment="Left" Margin="0,8,0,0" />
            <Button Content="Cash out +500" Command="{Binding CashShift.AddCashOutCommand}" Width="170" HorizontalAlignment="Left" Margin="0,8,0,0" />
            <Button Content="Cerrar caja local" Command="{Binding CashShift.CloseLocalShiftCommand}" Width="170" HorizontalAlignment="Left" Margin="0,8,0,0" />
          </StackPanel>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
