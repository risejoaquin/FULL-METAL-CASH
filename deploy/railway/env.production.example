ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
ConnectionStrings__Postgres=Host=<railway-or-supabase-host>;Port=5432;Database=<db>;Username=<user>;Password=<password>;Ssl Mode=Require;Trust Server Certificate=true
Jwt__SigningKey=<minimum-32-byte-secret>
Jwt__Issuer=SolidPOS
Jwt__Audience=SolidPOS.PosServer
AllowedHosts=<your-service>.up.railway.app;*.railway.app
Cors__AllowedOrigins__0=https://<your-dashboard-domain>
RateLimits__PermitLimit=600
RateLimits__WindowMinutes=1
RateLimits__QueueLimit=0
