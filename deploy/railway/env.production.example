ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Option A: Npgsql connection string
ConnectionStrings__Postgres=Host=<railway-or-supabase-host>;Port=5432;Database=<db>;Username=<user>;Password=<password>;SSL Mode=Require

# Option B: DATABASE_URL URI. PosServer normalizes this to Npgsql format at startup.
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require

Jwt__SigningKey=<minimum-32-byte-secret>
Jwt__Issuer=SolidPOS
Jwt__Audience=SolidPOS.PosServer
AllowedHosts=<your-service>.up.railway.app;healthcheck.railway.app;*.railway.app
Cors__AllowedOrigins__0=https://<your-dashboard-domain>
ENABLE_SWAGGER=false
RateLimits__PermitLimit=600
RateLimits__WindowMinutes=1
RateLimits__QueueLimit=0

PasswordPolicy__MinLength=12
PasswordPolicy__RequireUppercase=true
PasswordPolicy__RequireLowercase=true
PasswordPolicy__RequireDigit=true
PasswordPolicy__RequireNonAlphanumeric=true
PasswordPolicy__BlockCommonPasswords=true
AccountSecurity__MaxFailedLoginAttempts=5
AccountSecurity__LockoutMinutes=15

# Iteration 01 production provisioning bootstrap key.
# Required only while bootstrapping a real production tenant/admin.
PROVISION_KEY=change-me-to-a-long-random-production-bootstrap-key
Provisioning__AllowProductionBootstrap=true
Provisioning__DisableDemoUserByDefault=true
